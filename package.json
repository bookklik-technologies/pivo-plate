{
  "name": "@bookklik/pivo-plate",
  "version": "0.2.1",
  "license": "MIT",
  "author": "a-hakim",
  "private": false,
  "type": "module",
  "description": "A local-first browser tile-to-3D modeling editor.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/browser-readiness.mjs",
    "test:embed": "node scripts/browser-embed.mjs",
    "test:layout": "node tests/layout-check.mjs",
    "test:safety": "node tests/browser-safety.mjs",
    "test:modeling": "node tests/browser-modeling.mjs",
    "test:png": "node tests/browser-png.mjs",
    "test:erase-hud": "node tests/browser-erase-hud.mjs",
    "test:theme": "node tests/browser-theme.mjs",
    "test:font": "node tests/browser-font.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "docs:dev": "npm run docs:build && node scripts/preview-docs.mjs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:capture": "node scripts/capture-tutorials.mjs",
    "check:suite": "node scripts/check-suite.mjs",
    "check:dependencies": "node scripts/audit-dependencies.mjs",
    "test:release": "node scripts/browser-readiness.mjs",
    "test:browser:legacy": "node tests/browser-e2e.mjs",
    "capture:predecessor": "node scripts/capture-predecessor.mjs",
    "test:upgrade": "node scripts/browser-upgrade.mjs",
    "test:standalone": "node scripts/browser-standalone.mjs",
    "test:workers": "node scripts/browser-workers.mjs",
    "test:menus": "node scripts/browser-menus.mjs",
    "build:lib": "node scripts/build-library.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "prepack": "npm run build:lib && npm run check:package",
    "prepublishOnly": "npm run check:dependencies",
    "release:check": "npm run check:dependencies && npm run build && npm run docs:build && npm run build:lib && npm run check:package && npm run check:consumer"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pako": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@types/pako": "^2.0.4",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "5.0.4",
    "fake-indexeddb": "6.2.5",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "5.0.4",
    "@fontsource-variable/outfit": "^5.3.0",
    "lucide": "^1.54.0",
    "three": "^0.180.0",
    "esbuild": "0.28.2",
    "rollup": "4.65.1",
    "rollup-plugin-dts": "6.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./headless": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.js",
      "default": "./lib/core.js"
    },
    "./io": {
      "types": "./lib/io.d.ts",
      "import": "./lib/io.js",
      "default": "./lib/io.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "docs/npm.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/licenses"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/pivo-plate.git"
  },
  "homepage": "https://bookklik-technologies.github.io/pivo-plate/docs/",
  "bugs": {
    "url": "https://github.com/bookklik-technologies/pivo-plate/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pivo",
    "headless",
    "3d",
    "editor"
  ],
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.1",
    "fast-uri": "3.1.9",
    "serialize-javascript": "7.1.3",
    "vitepress": {
      "vite": "6.4.5"
    }
  }
}
