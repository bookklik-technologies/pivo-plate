{
  "name": "pivo-plate",
  "version": "0.1.0",
  "license": "MIT",
  "author": "a-hakim",
  "private": true,
  "type": "module",
  "description": "A local-first browser tile-to-3D modeling editor.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node tests/browser-e2e.mjs",
    "test:layout": "node tests/layout-check.mjs",
    "test:safety": "node tests/browser-safety.mjs",
    "test:modeling": "node tests/browser-modeling.mjs",
    "test:png": "node tests/browser-png.mjs",
    "test:erase-hud": "node tests/browser-erase-hud.mjs",
    "test:theme": "node tests/browser-theme.mjs",
    "test:font": "node tests/browser-font.mjs",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:capture": "node scripts/capture-tutorials.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "fflate": "^0.8.2",
    "lucide": "^1.54.0",
    "pako": "^2.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/pako": "^2.0.4",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
